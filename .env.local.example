# データベース（PostgreSQL）接続先。必須。
# 例: DATABASE_URL=postgres://modanica:パスワード@127.0.0.1:5432/modanica
DATABASE_URL=

# メール送信を実際に有効にするには、このファイルを同じフォルダ内に
# ".env.local" という名前でコピーして、値を書き換えてください。
# （.env.local はサーバー再起動後に自動で読み込まれます）
#
# .env.local を作らない・空のままにしておいても、アプリは動きます。
# その場合メールは実際には送信されず、「管理画面 > メール送信ログ」に
# 内容だけ記録される「ログモード」で動作します。

# Resend（https://resend.com）で発行したAPIキー
# 1. Resendにサインアップ（無料枠あり）
# 2. 送信元にしたいメールアドレス／ドメインを認証する
# 3. API Keysメニューでキーを発行し、下に貼り付ける
RESEND_API_KEY=

# 送信元として表示されるアドレス（Resend側で認証したドメインのアドレスを推奨）
# 例: MAIL_FROM="MODANICA <booking@modanica.example.com>"
MAIL_FROM="MODANICA <onboarding@resend.dev>"

# 新規予約が入るたびに通知を受け取りたい運営者側のメールアドレス（任意・複数はカンマ区切り）
# 例: ADMIN_NOTIFY_EMAIL="owner@example.com,staff@example.com"
ADMIN_NOTIFY_EMAIL=

# 管理画面（/admin、/api/admin配下）専用のログインページで使うID・パスワード。
# 両方とも必ず設定してください。未設定のままだと管理画面は開けない仕様になっています。
# /admin を開くと専用のログイン画面が表示されます（ブラウザ標準のベーシック認証ではありません）。
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# ログインセッションの署名に使う秘密鍵（推奨・任意の長いランダム文字列）。
# 未設定の場合は ADMIN_BASIC_AUTH_PASSWORD を代用しますが、本番運用ではこちらも設定してください。
ADMIN_SESSION_SECRET=
